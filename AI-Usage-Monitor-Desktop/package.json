{
  "name": "ai-usage-monitor-desktop",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
    "build": {
    "appId": "com.yourcompany.ai-usage-monitor",
    "productName": "AI Usage Monitor", 
    "directories": {
      "output": "dist" 
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/square-logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true, 
      "allowToChangeInstallationDirectory": true, 
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true, 
      "shortcutName": "AI Usage Monitor"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.0.0",
    "vite": "^5.0.0"
  }
}
